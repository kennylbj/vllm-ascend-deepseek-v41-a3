# =============================================================================
# Container runtime preset for an air-gapped Kylin V10 (glibc 2.28) A3 node.
#
# Copy to config/dsv41.local.env (machine-specific, gitignored):
#     cp config/dsv41.docker.env.example config/dsv41.local.env
# Full walkthrough: docs/offline-deployment.md
#
# The image is used as a runtime only: vLLM runs inside a long-lived container
# created from the locally loaded image (scripts/container.sh), so the host's
# old glibc / Python 3.7 are irrelevant. Nothing is downloaded.
# =============================================================================

# ---- runtime ---------------------------------------------------------------
DSV41_RUNTIME=docker
DSV41_IMAGE=quay.io/ascend/vllm-ascend:v0.30.0rc2-a3
DSV41_CONTAINER=dsv41

# Privileged container (all davinci devices, no SELinux/seccomp confinement).
# 0 → explicit --device list + relaxed seccomp (fallback, less tested).
DSV41_DOCKER_PRIVILEGED=1

# Host dir for the container's /root/.cache (triton/torch/vLLM compile caches)
# and /root/ascend (CANN logs): survives `container.sh recreate`, keeps the
# docker root disk clean.
DSV41_STATE_DIR=/data/dsv41

# ---- locations -------------------------------------------------------------
# Mounted into the container at the SAME path. Do not move it afterwards: the
# vLLM compile cache is keyed on the model path.
DSV41_MODEL=/data/DeepSeek-V4.1-Flash-1017-w8a8

# Logs and pid files (mounted at the same path). The pid dir must be a dedicated
# directory, never /tmp.
DSV41_RESULTS=/data/dsv41/logs
DSV41_LOG_DIR=/data/dsv41/logs
DSV41_PID_DIR=/run/dsv41

# ---- service ---------------------------------------------------------------
DSV41_HOST=0.0.0.0
DSV41_PORT=8021
DSV41_SERVED_NAME=dsv41
DSV41_DP=2
DSV41_TP=8

# external: prefix/KV-aware router on 8021 + supervisor 8020 + ranks 8022/8023.
DSV41_LB_MODE=external
DSV41_DP_SUPERVISOR_PORT=8020
DSV41_DP_BASE_PORT=8022
DSV41_KV_EVENTS=1
DSV41_KV_EVENTS_BASE_PORT=5557

# Router policy: cost (default, token-level score incl. KV saturation) | legacy (request-count skew).
# Roll back with:  DSV41_ROUTER_POLICY=legacy ROUTER_RESTART=1 bash scripts/serve.sh
DSV41_ROUTER_POLICY=cost
DSV41_ROUTER_KV_HIGH=0.90
DSV41_ROUTER_SAT_PENALTY=32768
DSV41_ROUTER_PREFILL_WEIGHT=0.5
DSV41_ROUTER_LOAD_INTERVAL=2
DSV41_ROUTER_MAX_SKEW=8

# Bearer token required when non-empty:  openssl rand -hex 32
DSV41_API_KEY=change-me-to-a-long-random-string

# ---- model / scheduler -----------------------------------------------------
DSV41_MAX_MODEL_LEN=360448
# A smaller prefill chunk limits decode stalls under DP2+EP lockstep.
# The historical benchmark tables used 16384. This setting changes the compile-cache key.
DSV41_MAX_NUM_BATCHED_TOKENS=4096
DSV41_MAX_NUM_SEQS=32
DSV41_GPU_MEM_UTIL=0.92
DSV41_BLOCK_SIZE=128
DSV41_ENABLE_PREFIX_CACHING=1
DSV41_ENABLE_EXPERT_PARALLEL=1
DSV41_ENABLE_PROMPT_TOKENS_DETAILS=1

# ---- speculative decoding ----------------------------------------------------
DSV41_SPEC_TOKENS=5

# ---- offline ---------------------------------------------------------------
DSV41_OFFLINE=1

# ---- runtime knobs ---------------------------------------------------------
DSV41_USE_V2=1
DSV41_HCCL_BUFFSIZE=1024
DSV41_HCCL_OP_EXPANSION_MODE=AIV
DSV41_SAFETENSORS_LOAD_STRATEGY=lazy
DSV41_LOADER_THREADS=128
DSV41_ENGINE_READY_TIMEOUT_S=36000

# ---- watchdog --------------------------------------------------------------
DSV41_CHECK_INTERVAL=30
DSV41_HEALTH_TIMEOUT=10
DSV41_GRACE_PERIOD=180
DSV41_STARTUP_TIMEOUT=3600
DSV41_STARTUP_POLL=15
DSV41_FAILURE_COOLDOWN=120
DSV41_STARTUP_FAIL_FAST=120

DSV41_ALLOW_MULTI=0

# Cleanup only ever touches this deployment's own processes (they carry a
# DSV41_PROC_TAG); other vLLM / NPU jobs on the node are left alone. Keep 0.
DSV41_CLEAN_ALL_VLLM=0
